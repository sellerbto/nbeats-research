#NBeats pipeline
import pandas as pd
import numpy as np
from neuralforecast import NeuralForecast
from neuralforecast.models import NBEATS
from neuralforecast.losses.pytorch import SMAPE, MASE, MAPE

def prepare_m4_for_neuralforecast(csv_path, freq="M"):
    """
    Преобразует сырой CSV M4 в формат [unique_id, ds, y]
    freq: "Y", "Q", "M", "W", "D", "H" (частота данных)
    """
    df = pd.read_csv(csv_path)
    
    # 1. Длинный формат: первая колонка = ID, остальные = значения
    id_col = df.columns[0]
    df_long = df.melt(id_vars=id_col, var_name='step', value_name='y')
    df_long = df_long.rename(columns={id_col: 'unique_id'})
    df_long = df_long.dropna(subset=['y'])  # убираем пустые хвосты
    
    # 2. Генерация ds (M4 не содержит реальных дат, используем условные)
    freq_map = {
        "Y": "YS", "Q": "QS", "M": "MS", 
        "W": "W-SUN", "D": "D", "H": "H"
    }
    freq_pd = freq_map.get(freq, "MS")
    
    # Для каждого ряда создаём последовательные даты, начиная с 2000-01-01
    df_long['ds'] = df_long.groupby('unique_id').apply(
        lambda g: pd.date_range(start='2000-01-01', periods=len(g), freq=freq_pd)
    ).explode().reset_index(drop=True)
    
    # 3. Возвращаем только нужные колонки в правильном порядке
    return df_long[['unique_id', 'ds', 'y']]

